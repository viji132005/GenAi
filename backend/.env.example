# SkillBridge AI Environment Variables

# Security & Authentication
SECRET_KEY=skillbridge-super-secret-jwt-key-2026-production-ready
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./skillbridge.db

# LLM Provider Configuration ('gemini', 'openai', or 'custom')
LLM_PROVIDER=gemini

# Google Gemini API Configuration (Get your free key at https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI / OpenAI-compatible API Configuration (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Custom / SkillBridge-LLM Configuration (Optional)
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=skillbridge-llm-v1

# Server & CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
UPLOAD_DIR=./uploads
